{
  "name": "biohub-api",
  "version": "0.0.0",
  "description": "API for BioHub Web App",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcgov/biohubbc-platform.git"
  },
  "scripts": {
    "start": "tsx src/app.ts",
    "build": "swc src --out-dir dist --strip-leading-paths",
    "typecheck": "tsc --project tsconfig.production.json",
    "typecheck:test": "tsc --noEmit --project tsconfig.mocha.json",
    "start-reload": "tsx watch src/app.ts",
    "queue": "tsx src/queue.ts",
    "queue-reload": "tsx watch src/queue.ts",
    "test:mocha": "cross-env TSX_TSCONFIG_PATH=./tsconfig.mocha.json node --import tsx ./node_modules/mocha/bin/mocha.js",
    "test": "npm run test:mocha -- --config .mocharc.json",
    "test-watch": "npm run test:mocha -- --config .mocharc.json --watch",
    "test:db": "npm run test:mocha -- --config .mocharc.integration.json",
    "test:bench": "npm run test:mocha -- --config .mocharc.benchmark.json",
    "test:sys": "npm run test:mocha -- --config .mocharc.system.json",
    "test:sys:file": "npm run test:mocha -- --no-config --extension ts --timeout 60000",
    "coverage": "cross-env TSX_TSCONFIG_PATH=./tsconfig.mocha.json c8 node --import tsx ./node_modules/mocha/bin/mocha.js --config .mocharc.json",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "format": "prettier --loglevel=warn --check \"./src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "format-fix": "prettier --loglevel=warn --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "fix": "npm-run-all -l -s lint-fix format-fix"
  },
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">= 10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/lib-storage": "^3.621.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@dsnp/parquetjs": "^1.8.8",
    "ajv": "^8.20.0",
    "archiver": "^8.0.0",
    "axios": "^1.21.1",
    "clamscan": "^2.2.1",
    "cron-parser": "^5.5.0",
    "dayjs": "^1.11.10",
    "express": "^4.22.3",
    "express-openapi": "^9.3.0",
    "express-rate-limit": "^7.5.1",
    "fast-xml-parser": "^5.12.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "knex": "^2.4.2",
    "lodash": "^4.18.1",
    "mime": "^3.0.0",
    "multer": "^2.5.0",
    "pg": "^8.7.1",
    "pg-boss": "^11.1.2",
    "qs": "^6.17.1",
    "sql-template-strings": "^2.2.2",
    "swagger-ui-express": "^4.3.0",
    "tar-stream": "^3.2.2",
    "uuid": "^11.1.1",
    "winston": "^3.3.3",
    "winston-daily-rotate-file": "^5.0.0",
    "wkx": "^0.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^1.3.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.15.3",
    "@types/archiver": "^8.0.0",
    "@types/chai": "^4.3.14",
    "@types/clamscan": "^2.0.8",
    "@types/express": "^4.17.13",
    "@types/geojson": "^7946.0.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.14.176",
    "@types/mapbox__vector-tile": "^1.3.4",
    "@types/mime": "^3.0.4",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^24.12.2",
    "@types/pbf": "^3.0.5",
    "@types/pg": "^8.11.4",
    "@types/sinon": "^17.0.3",
    "@types/sinon-chai": "^3.2.12",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^8.3.1",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "adm-zip": "^0.6.1",
    "c8": "^12.0.0",
    "chai": "^4.3.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "~8.10.0",
    "eslint-plugin-prettier": "~4.2.1",
    "mocha": "^12.0.3",
    "npm-run-all": "^4.1.5",
    "pbf": "^3.3.0",
    "prettier": "^2.8.8",
    "prettier-plugin-organize-imports": "^3.2.4",
    "sinon": "^17.0.1",
    "sinon-chai": "^3.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@swc/cli": {
      "minimatch": "^11.0.9"
    },
    "mocha": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    },
    "test-exclude": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    },
    "archiver": {
      "readdir-glob": "^4.0.0"
    }
  }
}
