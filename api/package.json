{
  "name": "biohub-api",
  "version": "0.0.0",
  "description": "API for BioHub Web App",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcgov/biohubbc-platform.git"
  },
  "scripts": {
    "start": "tsx src/app.ts",
    "build": "swc src --out-dir dist --strip-leading-paths",
    "typecheck": "tsc --project tsconfig.production.json",
    "start-reload": "tsx watch src/app.ts",
    "queue": "tsx src/queue.ts",
    "queue-reload": "tsx watch src/queue.ts",
    "test": "TSX_TSCONFIG_PATH=./tsconfig.mocha.json node --import tsx ./node_modules/mocha/bin/mocha.js --config .mocharc.json",
    "test-watch": "TSX_TSCONFIG_PATH=./tsconfig.mocha.json node --import tsx ./node_modules/mocha/bin/mocha.js --config .mocharc.json --watch",
    "test:db": "TSX_TSCONFIG_PATH=./tsconfig.mocha.json node --import tsx ./node_modules/mocha/bin/mocha.js --config .mocharc.integration.json",
    "test:sys": "TSX_TSCONFIG_PATH=./tsconfig.mocha.json node --import tsx ./node_modules/mocha/bin/mocha.js --config .mocharc.system.json",
    "coverage": "TSX_TSCONFIG_PATH=./tsconfig.mocha.json c8 node --import tsx ./node_modules/mocha/bin/mocha.js --config .mocharc.json",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "format": "prettier --loglevel=warn --check \"./src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "format-fix": "prettier --loglevel=warn --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "fix": "npm-run-all -l -s lint-fix format-fix"
  },
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">= 10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.583.0",
    "@aws-sdk/lib-storage": "^3.621.0",
    "@aws-sdk/s3-request-presigner": "^3.583.0",
    "@dsnp/parquetjs": "^1.8.7",
    "@types/tar-stream": "^3.1.4",
    "adm-zip": "^0.5.5",
    "ajv": "^8.12.0",
    "archiver": "^7.0.1",
    "axios": "^1.6.7",
    "clamscan": "^2.2.1",
    "dayjs": "^1.11.10",
    "db-migrate": "^0.11.11",
    "db-migrate-pg": "^1.2.2",
    "express": "^4.17.1",
    "express-openapi": "^9.3.0",
    "fast-xml-parser": "~4.1.3",
    "jsonpath-plus": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "knex": "^2.4.2",
    "lodash": "^4.17.21",
    "logform": "^2.3.2",
    "mime": "^3.0.0",
    "multer": "^2.0.2",
    "pg": "^8.7.1",
    "pg-boss": "^11.1.2",
    "qs": "^6.10.1",
    "sql-template-strings": "^2.2.2",
    "swagger-ui-express": "^4.3.0",
    "tar-stream": "^3.1.7",
    "uuid": "^11.0.5",
    "winston": "^3.3.3",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.15.3",
    "@types/adm-zip": "^0.4.34",
    "@types/archiver": "^7.0.0",
    "@types/chai": "^4.3.14",
    "@types/clamscan": "^2.0.8",
    "@types/express": "^4.17.13",
    "@types/geojson": "^7946.0.8",
    "@types/jsonwebtoken": "^8.5.5",
    "@types/lodash": "^4.14.176",
    "@types/mime": "^3.0.4",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.11.4",
    "@types/sinon": "^17.0.3",
    "@types/sinon-chai": "^3.2.12",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^8.3.1",
    "@types/yamljs": "^0.2.31",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "c8": "^10.1.3",
    "chai": "^4.3.4",
    "del": "~6.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "~8.10.0",
    "eslint-plugin-prettier": "~4.2.1",
    "glob": "^13.0.0",
    "mocha": "^11.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "prettier-plugin-organize-imports": "^3.2.4",
    "rimraf": "^6.1.2",
    "sinon": "^17.0.1",
    "sinon-chai": "^3.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "wkx": "^0.5.0"
  }
}
