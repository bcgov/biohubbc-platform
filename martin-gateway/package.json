{
  "name": "biohub-martin-gateway",
  "version": "0.0.0",
  "description": "Authenticating gateway that fronts the Martin vector tile server for BioHub",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcgov/biohubbc-platform.git"
  },
  "scripts": {
    "start": "tsx src/app.ts",
    "build": "swc src --out-dir dist --strip-leading-paths",
    "typecheck": "tsc --project tsconfig.production.json",
    "start-reload": "tsx watch src/app.ts",
    "test:mocha": "cross-env TSX_TSCONFIG_PATH=./tsconfig.mocha.json node --import tsx ./node_modules/mocha/bin/mocha.js",
    "test": "npm run test:mocha -- --config .mocharc.json",
    "test-watch": "npm run test:mocha -- --config .mocharc.json --watch",
    "test:integration": "npm run test:mocha -- --config .mocharc.integration.json",
    "coverage": "cross-env TSX_TSCONFIG_PATH=./tsconfig.mocha.json c8 node --import tsx ./node_modules/mocha/bin/mocha.js --config .mocharc.json",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "format": "prettier --loglevel=warn --check \"./src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "format-fix": "prettier --loglevel=warn --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "fix": "npm-run-all -l -s lint-fix format-fix"
  },
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">= 10.0.0"
  },
  "dependencies": {
    "express": "^4.17.1",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.0.2",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.15.3",
    "@types/chai": "^4.3.14",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.2",
    "@types/sinon": "^17.0.3",
    "@types/sinon-chai": "^3.2.12",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "c8": "^10.1.3",
    "chai": "^4.3.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "~8.10.0",
    "eslint-plugin-prettier": "~4.2.1",
    "mocha": "^11.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "prettier-plugin-organize-imports": "^3.2.4",
    "sinon": "^17.0.1",
    "sinon-chai": "^3.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
