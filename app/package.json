{
  "name": "biohub-app",
  "version": "0.0.0",
  "description": "BioHub Web App",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcgov/biohubbc-platform.git"
  },
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test-watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "format": "prettier --log-level=warn --check \"./src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "format-fix": "prettier --log-level=warn --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "fix": "npm-run-all -l -s lint-fix format-fix"
  },
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">= 10.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/lab": "^7.0.0-beta.17",
    "@mui/material": "^7.3.2",
    "@mui/system": "^7.3.2",
    "@mui/x-data-grid": "^8.11.2",
    "@tanstack/react-query": "^5.104.0",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/bbox": "^7.2.0",
    "axios": "^1.21.1",
    "dayjs": "^1.11.18",
    "express": "^5.3.0",
    "formik": "^2.4.6",
    "fuse.js": "^7.1.0",
    "jszip": "^3.10.1",
    "lodash-es": "^4.18.1",
    "maplibre-gl": "^6.19.0",
    "oidc-client-ts": "^3.3.0",
    "qs": "^6.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "react-oidc-context": "^3.3.0",
    "react-router": "^7.18.6",
    "react-router-dom": "^7.18.6",
    "shapefile": "^0.6.6",
    "terra-draw": "^1.32.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "uuid": "^13.0.2",
    "yup": "^1.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.3.1",
    "@types/qs": "^6.14.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/shapefile": "^0.6.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "~9.35.0",
    "eslint-plugin-prettier": "~5.5.4",
    "eslint-plugin-react-hooks": "~5.2.0",
    "jsdom": "^27.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.7.4",
    "prettier-plugin-organize-imports": "^4.2.0",
    "sass": "^1.92.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.8",
    "vite-plugin-checker": "^0.10.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!lodash-es)/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!<rootDir>/src/themes/**",
      "!<rootDir>/src/constants/**",
      "!<rootDir>/src/App.tsx",
      "!<rootDir>/src/types/**",
      "!<rootDir>/src/interfaces/**",
      "!<rootDir>/src/AppRouter.tsx",
      "!<rootDir>/src/react-app-env.d.ts",
      "!<rootDir>/src/index.tsx",
      "!<rootDir>/node_modules/**",
      "!<rootDir>/coverage/**",
      "!<rootDir>/public/**",
      "!<rootDir>/build/**",
      "!<rootDir>/src/serviceWorker.**",
      "!<rootDir>/src/setupTests.*"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    },
    "coverageReporters": [
      "text",
      "lcov"
    ]
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.18"
    }
  }
}
